<idea-plugin>
    <id>org.mc-stan.stan</id>
    <name>Stan Language Support</name>
    <vendor>Community</vendor>
    <description><![CDATA[
        <a href="https://mc-stan.org/">Stan</a> plugin for JetBrains IDEs.<br/><br/>
        Currently supports:
        <ul>
            <li>Syntax highlighting (configurable: Settings → Editor → Color Scheme → Stan)</li>
            <li>Syntax validation (full AST parsing internally)</li>
            <li>Code folding (on <code>{}</code> blocks)</li>
            <li>Basic autocompletion (all builtins, keywords, variable names in scope)</li>
            <li>Basic type checking</li>
            <li>Semantic checks for unused variables</li>
            <li>Semantic checks for name shadowing</li>
            <li>Create a new Stan file from the file explorer context menu</li>
        </ul>
        Reuses syntax and semantics defined in <a href="https://github.com/stan-dev/stanc3">Stanc3</a>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action id="Stan.NewFile"
                class="org.intellij.stan.StanCreateFileAction"
                text="Stan File"
                description="Create a new Stan model file">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Stan"
            implementationClass="org.intellij.stan.StanFileType"
            fieldName="INSTANCE"
            language="Stan"
            extensions="stan"/>

        <lang.parserDefinition
            language="Stan"
            implementationClass="org.intellij.stan.StanParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="Stan"
            implementationClass="org.intellij.stan.StanSyntaxHighlighterFactory"/>

        <colorSettingsPage
            implementation="org.intellij.stan.StanColorSettingsPage"/>

        <annotator
            language="Stan"
            implementationClass="org.intellij.stan.StanSemanticHighlightAnnotator"/>

        <lang.foldingBuilder
            language="Stan"
            implementationClass="org.intellij.stan.StanFoldingBuilder"/>

        <completion.contributor
            language="Stan"
            implementationClass="org.intellij.stan.StanCompletionContributor"/>

        <typedHandler
            implementationClass="org.intellij.stan.StanBracketHandler"/>

        <localInspection
            language="Stan"
            displayName="Reserved word used as identifier"
            groupName="Stan"
            implementationClass="org.intellij.stan.StanReservedWordAnnotator"
            enabledByDefault="true"
            level="ERROR"/>

        <localInspection
            language="Stan"
            displayName="Consecutive unary operators"
            groupName="Stan"
            implementationClass="org.intellij.stan.StanConsecutiveUnaryInspection"
            enabledByDefault="true"
            level="WARNING"/>

        <localInspection
            language="Stan"
            displayName="Undeclared variable"
            groupName="Stan"
            implementationClass="org.intellij.stan.StanUndeclaredVariableInspection"
            enabledByDefault="true"
            level="ERROR"/>

        <localInspection
            language="Stan"
            displayName="Function call type/arity mismatch"
            groupName="Stan"
            implementationClass="org.intellij.stan.StanFunctionCallInspection"
            enabledByDefault="true"
            level="ERROR"/>

        <localInspection
            language="Stan"
            displayName="Type mismatch"
            groupName="Stan"
            implementationClass="org.intellij.stan.StanTypeMismatchInspection"
            enabledByDefault="true"
            level="ERROR"/>

        <localInspection
            language="Stan"
            displayName="Unused variable"
            groupName="Stan"
            implementationClass="org.intellij.stan.StanUnusedVariableInspection"
            enabledByDefault="true"
            level="WARNING"/>

        <localInspection
            language="Stan"
            displayName="Name shadows built-in function"
            groupName="Stan"
            implementationClass="org.intellij.stan.StanShadowingInspection"
            enabledByDefault="true"
            level="WARNING"/>

        <localInspection
            language="Stan"
            displayName="_rng function called outside allowed context"
            groupName="Stan"
            implementationClass="org.intellij.stan.StanRngCallContextInspection"
            enabledByDefault="true"
            level="ERROR"/>
    </extensions>
</idea-plugin>
